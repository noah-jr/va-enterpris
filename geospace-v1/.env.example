# ============================================
# CISP-ADMIN - Variáveis de Ambiente
# ============================================
# Copie este arquivo para .env.local e preencha os valores

# ============================================
# API
# ============================================
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
NEXT_PUBLIC_SOCKET_URL=http://localhost:3000

# ============================================
# APP INFO
# ============================================
NEXT_PUBLIC_APP_NAME=Filogo CISP
NEXT_PUBLIC_APP_VERSION=1.0.0

# ============================================
# MAPS
# ============================================
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=sua_chave_google_maps
NEXT_PUBLIC_MAP_CENTER_LAT=-8.8383
NEXT_PUBLIC_MAP_CENTER_LNG=13.2344
NEXT_PUBLIC_MAP_ZOOM=12

# ============================================
# CISP SPECIFIC
# ============================================
NEXT_PUBLIC_EMERGENCY_REFRESH_INTERVAL=5000  # 5 segundos
NEXT_PUBLIC_LOCATION_REFRESH_INTERVAL=3000   # 3 segundos
NEXT_PUBLIC_ENABLE_AUDIO_ALERTS=true
NEXT_PUBLIC_MAX_EMERGENCIES_DISPLAY=50

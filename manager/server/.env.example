# VA ONEGEST — Template de Configuração de Ambiente
NODE_ENV=development
PORT=5000

# Base de Dados (Prisma)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/DATABASE?schema=public"

# URLs permitidos (CORS)
CLIENT_URL=http://localhost:5000

# JWT — MUDAR EM PRODUÇÃO!
JWT_SECRET=mudar_este_secret_em_producao
JWT_REFRESH_SECRET=mudar_este_refresh_secret_em_producao
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Rate Limiting (Proteção contra Abuso & DDoS)
RATE_LIMIT_GLOBAL_WINDOW_MS=900000 # 15 minutos em milissegundos
RATE_LIMIT_GLOBAL_MAX=1000         # Máximo de requisições globais por janela
RATE_LIMIT_AUTH_WINDOW_MS=3600000  # 1 hora em milissegundos
RATE_LIMIT_AUTH_MAX=20             # Máximo de tentativas de login/registo
RATE_LIMIT_AI_WINDOW_MS=60000      # 1 minuto em milissegundos
RATE_LIMIT_AI_MAX=10               # Máximo de requisições ao bot de IA

# Conta System Admin
SYSTEM_EMAIL=admin@empresa.co.ao
SYSTEM_PASSWORD=mudar_em_producao

# IA — Google Gemini (Gemini 2.0 Flash)
GEMINI_API_KEY=sua_chave_api_aqui

# Cloudinary (Uploads)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=seu_cloud_name
CLOUDINARY_API_KEY=sua_api_key
CLOUDINARY_API_SECRET=seu_api_secret

# Fiscal (AGT Angola)
# Chave Privada RSA 2048-bit em formato PEM (gerar com scripts/gerar-chaves-agt.cjs)
# Usar $(cat agt/chave-privada.pem) para ler o ficheiro
AGT_PRIVATE_KEY_PEM="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# N.º de certificado atribuído pela AGT após aprovação da Declaração Modelo 8
AGT_CERTIFICATE_NUMBER="232/AGT/2026"
# Versão da chave privada (incrementar sempre que regenerar a chave)
AGT_KEY_VERSION=1

# Identificação do Software
SOFTWARE_COMPANY_ID="NOME-DA-SUA-EMPRESA-LDA"

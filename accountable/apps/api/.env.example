PORT=3001
# Só "development" e "test" desativam as proteções de produção. Não definido = produção.
NODE_ENV=development

# Proxies em que confiar para X-Forwarded-For (false | true | nº de saltos | lista de IPs/CIDRs).
# Deixe "false" se a API estiver exposta diretamente; caso contrário o IP do cliente pode ser falsificado.
TRUST_PROXY=false

# Database
DATABASE_URL="mysql://accountable:accountable@localhost:3306/accountable"

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cookie
COOKIE_SECRET=change-me-cookie-secret-min-32-chars

# Chave para cifrar os tokens das sessões públicas de upload (min. 32 caracteres)
UPLOAD_TOKEN_ENCRYPTION_KEY=change-me-upload-token-key-min-32-chars

# Chave HMAC dos códigos OTP enviados por email (min. 32 caracteres)
OTP_SECRET=change-me-otp-secret-min-32-chars

# Validade (dias) das sessões públicas de upload criadas sem prazo explícito
UPLOAD_SESSION_TTL_DAYS=30

# Armazenamento de documentos: "local" (disco, por omissão) ou "minio" (S3)
STORAGE_DRIVER=local
# Pasta dos documentos (relativa a apps/api). Por omissão: apps/api/storage
LOCAL_STORAGE_PATH=storage
# Segredo HMAC dos links de download temporários (min. 32 caracteres)
STORAGE_SIGNING_SECRET=change-me-storage-signing-secret-min-32

# MinIO (usado apenas com STORAGE_DRIVER=minio)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET_DOCUMENTS=accountable-documents
MINIO_BUCKET_BACKUPS=accountable-backups

# Email (MailHog for dev)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Accountable
SMTP_FROM_EMAIL=no-reply@accountable.local

# App
APP_URL=http://localhost:5173
API_URL=http://localhost:3001
ADMIN_URL=http://localhost:5174

# Rate limiting
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW_MS=900000
# Endpoints de token (verify-email, set-password, reset-password, refresh)
RATE_LIMIT_TOKEN_MAX=20
RATE_LIMIT_TOKEN_WINDOW_MS=60000

# Bcrypt
BCRYPT_ROUNDS=12

# File upload
MAX_FILE_SIZE_MB=10

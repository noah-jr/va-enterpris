'use client';

import { useQuery } from '@tanstack/react-query';
import {
    Briefcase,
    Users,
    Wrench,
    FileText,
    TrendingUp,
    Activity,
    Mail,
    MessageSquare
} from 'lucide-react';
import {
    BarChart,
    Bar,
    XAxis,
    YAxis,
    CartesianGrid,
    Tooltip,
    ResponsiveContainer,
    LineChart,
    Line,
    AreaChart,
    Area
} from 'recharts';
import { format, startOfMonth, endOfMonth, eachMonthOfInterval, subMonths, isSameMonth } from 'date-fns';
import { pt } from 'date-fns/locale';
import { StatCard, ChartCard } from '@/components/admin/dashboard-cards';

export default function AdminDashboard() {
    const { data: projectsData } = useQuery({
        queryKey: ['admin-projects'],
        queryFn: async () => {
            const res = await fetch('/api/projects');
            if (!res.ok) return { projects: [] };
            return res.json();
        },
    });

    const { data: usersData } = useQuery({
        queryKey: ['admin-users'],
        queryFn: async () => {
            const res = await fetch('/api/users');
            if (!res.ok) return { users: [] };
            return res.json();
        },
    });

    const { data: servicesData } = useQuery({
        queryKey: ['admin-services'],
        queryFn: async () => {
            const res = await fetch('/api/services');
            if (!res.ok) return { services: [] };
            return res.json();
        },
    });

    const { data: requestsData } = useQuery({
        queryKey: ['admin-service-requests'],
        queryFn: async () => {
            const res = await fetch('/api/service-requests');
            if (!res.ok) return { requests: [] };
            return res.json();
        },
    });

    const { data: newsletterData } = useQuery({
        queryKey: ['admin-newsletter'],
        queryFn: async () => {
            const res = await fetch('/api/newsletter/subscribers');
            if (!res.ok) return { subscribers: [] };
            return res.json();
        },
    });

    const { data: contactsData } = useQuery({
        queryKey: ['admin-contacts'],
        queryFn: async () => {
            const res = await fetch('/api/contact');
            if (!res.ok) return { contacts: [] };
            return res.json();
        },
    });

    const { data: postsData } = useQuery({
        queryKey: ['admin-posts'],
        queryFn: async () => {
            const res = await fetch('/api/posts');
            if (!res.ok) return { posts: [] };
            return res.json();
        },
    });

    const projects = projectsData?.projects ?? [];
    const users = usersData?.users ?? [];
    const services = servicesData?.services ?? [];
    const requests = requestsData?.requests ?? [];
    const subscribers = newsletterData?.subscribers ?? [];
    const contacts = contactsData?.contacts ?? [];
    const posts = postsData?.posts ?? [];

    const stats = [
        {
            name: 'Solicitações',
            value: requests.length,
            icon: FileText,
            color: 'bg-orange-500',
            trend: `${requests.filter((r: any) => r.status === 'NEW').length} pendentes`
        },
        {
            name: 'Newsletter',
            value: subscribers.length,
            icon: Mail,
            color: 'bg-gray-900',
            trend: 'Subscritores totais'
        },
        {
            name: 'Contactos',
            value: contacts.length,
            icon: MessageSquare,
            color: 'bg-indigo-500',
            trend: `${contacts.filter((c: any) => !c.isReplied).length} sem resposta`
        },
        {
            name: 'Blog',
            value: posts.length,
            icon: TrendingUp,
            color: 'bg-pink-500',
            trend: `${posts.filter((p: any) => p.status === 'PUBLISHED').length} publicados`
        }
    ];

    // Data for charts
    const last6Months = eachMonthOfInterval({
        start: subMonths(new Date(), 5),
        end: new Date()
    });

    const requestsChartData = last6Months.map(month => {
        const monthName = format(month, 'MMM', { locale: pt });
        return {
            name: monthName.charAt(0).toUpperCase() + monthName.slice(1),
            total: requests.filter((r: any) => isSameMonth(new Date(r.createdAt), month)).length
        };
    });

    const growthData = last6Months.map(month => {
        const monthName = format(month, 'MMM', { locale: pt });
        return {
            name: monthName.charAt(0).toUpperCase() + monthName.slice(1),
            users: users.filter((u: any) => new Date(u.createdAt) <= endOfMonth(month)).length,
            subs: subscribers.filter((s: any) => new Date(s.createdAt) <= endOfMonth(month)).length
        };
    });

    const COLORS = ['#10B981', '#3B82F6', '#6366F1', '#F59E0B', '#EC4899'];

    return (
        <div className="p-6 lg:p-12 space-y-12 bg-gradient-to-br from-gray-50 to-white dark:from-[#050505] dark:to-[#0a0a0a] font-sans min-h-screen">
            <div className="flex flex-col md:flex-row md:items-center justify-between gap-6 uppercase">
                <div className="space-y-2">
                    <div className="flex items-center gap-3">
                        <div className="h-4 w-1 bg-black dark:bg-white" />
                        <span className="text-[10px] font-black tracking-[0.4em] text-gray-600 dark:text-gray-400 italic">Central Systems Dashboard</span>
                    </div>
                    <h1 className="font-space text-4xl lg:text-6xl font-black text-black dark:text-white tracking-tighter">
                        Operational <span className="text-gray-600 dark:text-gray-400">Overview.</span>
                    </h1>
                </div>
            </div>

            {/* Stats Grid */}
            <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
                {stats.map((stat) => (
                    <StatCard
                        key={stat.name}
                        title={stat.name}
                        value={stat.value}
                        trend={stat.trend}
                        icon={stat.icon}
                    />
                ))}
            </div>

            {/* Charts Section */}
            <div className="grid grid-cols-1 lg:grid-cols-2 gap-6">
                {/* Requests per Month */}
                <ChartCard title="Solicitações por Mês">
                    <ResponsiveContainer width="100%" height="100%">
                        <BarChart data={requestsChartData}>
                            <CartesianGrid strokeDasharray="3 3" vertical={false} stroke="currentColor" opacity={0.1} />
                            <XAxis
                                dataKey="name"
                                axisLine={false}
                                tickLine={false}
                                tick={{ fill: 'currentColor', fontSize: 10, fontWeight: 'bold' }}
                            />
                            <YAxis
                                axisLine={false}
                                tickLine={false}
                                tick={{ fill: 'currentColor', fontSize: 10, fontWeight: 'bold' }}
                            />
                            <Tooltip
                                contentStyle={{
                                    backgroundColor: 'rgba(0,0,0,0.9)',
                                    border: 'none',
                                    color: 'white',
                                    fontSize: '12px',
                                    fontWeight: 'bold'
                                }}
                            />
                            <Bar dataKey="total" fill="currentColor" />
                        </BarChart>
                    </ResponsiveContainer>
                </ChartCard>

                {/* User Growth */}
                <ChartCard title="Crescimento de Utilizadores">
                    <ResponsiveContainer width="100%" height="100%">
                        <AreaChart data={growthData}>
                            <CartesianGrid strokeDasharray="3 3" vertical={false} stroke="currentColor" opacity={0.1} />
                            <XAxis
                                dataKey="name"
                                axisLine={false}
                                tickLine={false}
                                tick={{ fill: 'currentColor', fontSize: 10, fontWeight: 'bold' }}
                            />
                            <YAxis
                                axisLine={false}
                                tickLine={false}
                                tick={{ fill: 'currentColor', fontSize: 10, fontWeight: 'bold' }}
                            />
                            <Tooltip
                                contentStyle={{
                                    backgroundColor: 'rgba(0,0,0,0.9)',
                                    border: 'none',
                                    color: 'white',
                                    fontSize: '12px',
                                    fontWeight: 'bold'
                                }}
                            />
                            <Area type="monotone" dataKey="users" stroke="currentColor" fill="currentColor" fillOpacity={0.2} />
                        </AreaChart>
                    </ResponsiveContainer>
                </ChartCard>
                <XAxis dataKey="name" axisLine={false} tickLine={false} tick={{ fontSize: 12, fill: '#9ca3af' }} />
                <YAxis axisLine={false} tickLine={false} tick={{ fontSize: 12, fill: '#9ca3af' }} />
                <Tooltip
                    cursor={{ fill: 'rgba(0,0,0,0.05)' }}
                    contentStyle={{ borderRadius: '12px', border: 'none', boxShadow: '0 10px 15px -3px rgb(0 0 0 / 0.1)', backgroundColor: 'rgba(255, 255, 255, 0.98)' }}
                />
                <Bar dataKey="total" fill="#F59E0B" radius={[6, 6, 0, 0]} barSize={40} />
            </BarChart>
        </ResponsiveContainer>
                    </div >
                </div >

        {/* Users & Subscribers Growth */ }
        < div className = "bg-white dark:bg-gray-900 p-6 rounded-xl border border-gray-200 dark:border-gray-800 shadow-sm" >
                    <h3 className="text-lg font-bold text-black dark:text-white mb-6 flex items-center gap-2">
                        <TrendingUp size={20} className="text-gray-900" />
                        Crescimento da Audiência
                    </h3>
                    <div className="h-80 w-full">
                        <ResponsiveContainer width="100%" height="100%">
                            <AreaChart data={growthData}>
                                <defs>
                                    <linearGradient id="colorUsers" x1="0" y1="0" x2="0" y2="1">
                                        <stop offset="5%" stopColor="#6366F1" stopOpacity={0.3} />
                                        <stop offset="95%" stopColor="#6366F1" stopOpacity={0} />
                                    </linearGradient>
                                    <linearGradient id="colorSubs" x1="0" y1="0" x2="0" y2="1">
                                        <stop offset="5%" stopColor="#3B82F6" stopOpacity={0.3} />
                                        <stop offset="95%" stopColor="#3B82F6" stopOpacity={0} />
                                    </linearGradient>
                                </defs>
                                <CartesianGrid strokeDasharray="3 3" vertical={false} stroke="#374151" opacity={0.1} />
                                <XAxis dataKey="name" axisLine={false} tickLine={false} tick={{ fontSize: 12, fill: '#9ca3af' }} />
                                <YAxis axisLine={false} tickLine={false} tick={{ fontSize: 12, fill: '#9ca3af' }} />
                                <Tooltip
                                    contentStyle={{ borderRadius: '12px', border: 'none', boxShadow: '0 10px 15px -3px rgb(0 0 0 / 0.1)', backgroundColor: 'rgba(255, 255, 255, 0.98)' }}
                                />
                                <Area type="monotone" dataKey="users" name="Utilizadores" stroke="#6366F1" fillOpacity={1} fill="url(#colorUsers)" strokeWidth={3} />
                                <Area type="monotone" dataKey="subs" name="Subscritores" stroke="#3B82F6" fillOpacity={1} fill="url(#colorSubs)" strokeWidth={3} />
                            </AreaChart>
                        </ResponsiveContainer>
                    </div>
                </div >

        {/* Additional Stats Section */ }
        < div className = "bg-white dark:bg-gray-900 p-6 rounded-xl border border-gray-200 dark:border-gray-800 shadow-sm" >
                    <h3 className="text-lg font-bold text-black dark:text-white mb-6 flex items-center gap-2">
                        <Activity size={20} className="text-green-500" />
                        Resumo de Conteúdo
                    </h3>
                    <div className="grid grid-cols-2 gap-4">
                        <div className="p-4 rounded-xl bg-gray-50 dark:bg-gray-800/50">
                            <p className="text-sm text-gray-500">Total Posts</p>
                            <p className="text-2xl font-bold">{posts.length}</p>
                            <p className="text-xs text-green-500 mt-1">{posts.filter((p: any) => p.status === 'PUBLISHED').length} Publicados</p>
                        </div>
                        <div className="p-4 rounded-xl bg-gray-50 dark:bg-gray-800/50">
                            <p className="text-sm text-gray-500">Total Contactos</p>
                            <p className="text-2xl font-bold">{contacts.length}</p>
                            <p className="text-xs text-orange-500 mt-1">{contacts.filter((c: any) => !c.isReplied).length} Pendentes</p>
                        </div>
                    </div>
                </div >
            </div >
        </div >
    );
}
